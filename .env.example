# Copia este archivo a .env y rellena los valores. El .env real nunca se sube.

# --- Postgres (un servidor, una base por servicio) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hub
POSTGRES_PASSWORD=cambia-esto-en-local
POSTGRES_APP_USER=hub_app
POSTGRES_APP_PASSWORD=cambia-esto-tambien

# --- JWT ---
# En producción esto sale del vault (Infisical / AWS Secrets Manager), no de un .env.
JWT_ISSUER=https://identity.hub.local
JWT_AUDIENCE=hub-negocios
JWT_SIGNING_KEY=clave-de-desarrollo-de-al-menos-32-caracteres

# --- Event bus ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=hub
RABBITMQ_PASSWORD=cambia-esto

# --- Observabilidad ---
ASPNETCORE_ENVIRONMENT=Development
SERILOG_MINIMUM_LEVEL=Information
